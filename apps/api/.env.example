DATABASE_URL="postgres://postgres:replace-with-your-password@localhost:5432/employee-info"
WEB_ORIGIN="http://localhost:5173"
PORT=4000
EMPLOYEE_EMAILS='[]'

# Optional Jira Cloud integration. Leave blank to show the setup state.
JIRA_CLIENT_ID=""
JIRA_CLIENT_SECRET=""
JIRA_CALLBACK_URL="http://localhost:4000/jira/callback"
JIRA_SITE_URL=""
# Comma-separated approved project keys; empty permits accessible projects on the approved site.
JIRA_PROJECT_KEYS=""
# A stable base64-encoded 32-byte key, generated once and stored outside the database.
JIRA_TOKEN_ENCRYPTION_KEY=""
# Monitoring: debug, info, warn, error, fatal, or silent. Default: info.
LOG_LEVEL=info
# Optional deployment version (commit SHA or release identifier).
APP_RELEASE=
